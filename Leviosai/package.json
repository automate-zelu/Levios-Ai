{
  "name": "leviosai-crm",
  "version": "1.0.0",
  "description": "Leviosai AI-Powered Sales CRM",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --test tests/**/*.test.ts",
    "test:pipelines": "tsx --test tests/pipelines-all-scenarios.test.ts tests/sdr-sms-followup.test.ts tests/m1-sdr-sequence.test.ts tests/m2-calling-layer.test.ts tests/m7-reenroll.test.ts tests/m8-compliance.test.ts tests/booking-lifecycle.test.ts tests/browser-test-call.test.ts tests/test-credits.test.ts tests/commercial-pricing.test.ts tests/subscription-billing.test.ts tests/email-templates.test.ts tests/org-tenant.test.ts",
    "test:m2": "tsx --test tests/m2-calling-layer.test.ts",
    "test:m3": "tsx --test tests/m3-ui-helpers.test.ts",
    "test:m4": "tsx --test tests/m4-billing-tiers.test.ts",
    "test:m5": "tsx --test tests/m5-onboarding.test.ts",
    "test:m6": "tsx --test tests/m6-admin.test.ts",
    "test:m7": "tsx --test tests/m7-reenroll.test.ts",
    "test:m8": "tsx --test tests/m8-compliance.test.ts",
    "test:m9": "tsx --test tests/m9-kb.test.ts",
    "test:m10": "tsx --test tests/m10-calendar.test.ts",
    "test:week5": "SDR_DRY_RUN=1 tsx --test tests/week5-integration.test.ts",
    "test:ci": "tsx --test tests/m*.test.ts tests/pricing.test.ts tests/ops-alerts.test.ts tests/telephony-byot.test.ts tests/telnyx-media-flow.test.ts",
    "stripe:sync-prices": "tsx scripts/create-stripe-prices.ts",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:install": "cd client && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@deepgram/sdk": "^5.4.0",
    "@langchain/anthropic": "^1.5.6",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@sendgrid/mail": "^8.1.0",
    "@sentry/node": "^10.47.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.4.4",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.10.0",
    "stripe": "^21.0.1",
    "telnyx": "^7.22.0",
    "twilio": "^5.4.0",
    "vite": "^8.0.3",
    "word-extractor": "^1.0.4",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
